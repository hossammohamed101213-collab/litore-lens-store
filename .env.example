# Litore — copy to .env.local (never commit real values)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Data (keep these folders on persistent disk and back them up)
DATABASE_PATH=./data/litore.db
UPLOAD_DIR=./data/uploads

# Providers: commerce = db | mock ; shipping = zones | mock ; payment is mock until a licensed gateway is connected
COMMERCE_PROVIDER=db
SHIPPING_PROVIDER=zones

# Payment: cod = cash on delivery (live default) | mock = demo only (marks orders paid WITHOUT charging)
PAYMENT_MODE=cod

# DEMO ONLY: inserts sample products/coupon/shipping. NEVER set true on the live store.
SEED_SAMPLE=false

# Customer-care WhatsApp number (digits only, with country code). Default is set in src/lib/site.ts
NEXT_PUBLIC_WHATSAPP=971569449531

# Announcement bar (leave empty to hide; only real offers)
NEXT_PUBLIC_ANNOUNCEMENT_AR=
NEXT_PUBLIC_ANNOUNCEMENT_EN=

# Optional: automatic password-reset emails via Resend
# RESEND_API_KEY=
# EMAIL_FROM="Litore <no-reply@litore.store>"
